{
  "name": "agentdock",
  "version": "0.1.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/ybh618618/agentdock.git"
  },
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "build": "bun run --filter '*' build",
    "compile:linux": "mkdir -p dist/linux-amd64 && bun build ./apps/server/src/index.ts --compile --target=bun-linux-x64-baseline --outfile dist/linux-amd64/agentdock",
    "build:binary": "bun run build && bun run compile:linux",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "check": "bun run typecheck && bun run test && bun run build",
    "start": "bun run --cwd apps/server start",
    "format": "biome format --write .",
    "lint": "biome check ."
  },
  "devDependencies": {
    "@biomejs/biome": "latest",
    "@types/bun": "latest",
    "typescript": "latest"
  }
}
