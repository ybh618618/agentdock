{
  "name": "@agentdock/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "start": "NODE_ENV=production bun src/index.ts",
    "build": "bun build ./src/index.ts --outdir dist --target bun --sourcemap=external",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@agentdock/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "latest",
    "bun-types": "latest"
  }
}
